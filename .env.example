# Copy to .env and fill in. Never commit .env.
# Generate secrets with: make secrets

ENV=dev
DEMO_MODE=true
DATA_DIR=./data
COMPANY_TZ=America/Los_Angeles

# LLM: "gemini" (needs GEMINI_API_KEY) or "fake" (canned responses, no network)
LLM_PROVIDER=fake
GEMINI_API_KEY=

# Required. At least 32 characters each.
SESSION_SECRET=
KEK_KEYS=
LOG_HASH_PEPPER=

# Real Google mode only (DEMO_MODE=false). Must stay empty in demo mode.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BOOTSTRAP_OWNER_EMAIL=
